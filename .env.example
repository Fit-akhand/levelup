# Copy this file to .env.local (development) and fill in the values.
# In production, set these in your hosting provider's settings instead. NEVER commit real secrets.

# Master switch for ALL payment features (Plus, pricing page, coupons, payment routes).
# Anything but "true" = OFF: everything is free and no payment UI is shown.
NEXT_PUBLIC_PAYMENTS_ENABLED=

# "razorpay" (default) takes real payments. "mock" fakes them and ONLY works when NODE_ENV is not
# production. Leave unset in production.
PAYMENTS_MODE=

# From the Razorpay dashboard (Settings > API Keys). Use rzp_test_ keys while testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Made by `npm run keys`. The PRIVATE key stays on the server. The PUBLIC key ships in the app.
PAYMENT_SIGNING_KEY_JWK=
NEXT_PUBLIC_ENTITLEMENT_PUBLIC_KEY_JWK=

# Free coupons, as CODE:days pairs separated by commas. Example: WELCOME30:30,FRIEND:14
# Codes are case-insensitive. Leave empty to switch coupons off.
COUPON_CODES=
